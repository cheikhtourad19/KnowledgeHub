# ==============================================
# KnowledgeHub Environment Variables Template
# ==============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ==============================================
REGISTRY_USERNAME=cheikhtourad
IMAGE_TAG=1.0.0
# REGISTRY=ghcr.io
# ---------------------------------------------
# MySQL Database Configuration
# ---------------------------------------------
# Use 'localhost' - works for both local dev and Docker containers
# (Docker containers can reach host via host.docker.internal, but we'll use localhost with proper network config)
MYSQL_ROOT_PASSWORD=JYzNL0Tfb5r65W3dayz03/xDwS34yj6Z
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Database Names
MYSQL_AUTH_DB=knowledgehub_auth
MYSQL_USER_DB=knowledgehub_user
MYSQL_RESOURCE_DB=knowledgehub_ressource

# Database User Credentials
MYSQL_USERNAME=root
MYSQL_PASSWORD=JYzNL0Tfb5r65W3dayz03/xDwS34yj6Z

# ---------------------------------------------
# MongoDB Configuration
# ---------------------------------------------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=7pVY9aXr9sIhKWGZATbud/5EjdWBhDgb
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=notification_db

# MongoDB Connection String - localhost works for both local and Docker
# Password contains '/' which must be URL-encoded as '%2F'
MONGO_URI=mongodb://admin:7pVY9aXr9sIhKWGZATbud%2F5EjdWBhDgb@mongodb:27017/notification_db?authSource=admin

# ---------------------------------------------
# MinIO Object Storage Configuration
# ---------------------------------------------
# For Docker: use service name 'minio'
# For local dev: use 'localhost'
MINIO_ENDPOINT=http://minio:9000
MINIO_EXTERNAL_ENDPOINT=http://192.168.56.11:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=IM0i7/Sb3/tGGxWQdtxBtMRWov3fZ3qf
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=IM0i7/Sb3/tGGxWQdtxBtMRWov3fZ3qf

# MinIO Bucket Names
MINIO_BUCKET_DOCUMENTS=knowledgehub-documents
MINIO_BUCKET_PFA=knowledgehub-pfa
MINIO_BUCKET_PFE=knowledgehub-pfe
MINIO_BUCKET_STAGE=knowledgehub-stage
MINIO_BUCKET_JOURNAL=knowledgehub-journal
MINIO_BUCKET_ATTESTATION=knowledgehub-attestation

# ---------------------------------------------
# JWT Configuration
# ---------------------------------------------
JWT_SECRET=SMHWV9Em+mtG0bVR9Cpoummg8Tg1lKSvc5q34ysfar4=
JWT_EXPIRATION=86400000
# JWT expiration in milliseconds (86400000 = 24 hours)
JWT_REFRESH_EXPIRATION=604800000
# JWT refresh token expiration (604800000 = 7 days)

# ---------------------------------------------
# Email / SMTP Configuration (for Notifications)
# ---------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=elghothvadel@gmail.com
SMTP_PASSWORD=irur psog dfhb ohsm
SMTP_FROM_EMAIL=elghothvadel@gmail.com
SMTP_FROM_NAME=KnowledgeHub

# ---------------------------------------------
# Service Ports Configuration
# ---------------------------------------------
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
RESOURCE_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
AI_SEARCH_SERVICE_PORT=8000

# ---------------------------------------------
# Spring Boot Configuration
# ---------------------------------------------
SPRING_PROFILES_ACTIVE=docker

# JVM Memory Configuration
JAVA_OPTS=-Xms512m -Xmx1024m

# JPA Configuration
SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# File Upload Configuration
FILE_MAX_SIZE=100MB
FILE_MAX_REQUEST_SIZE=100MB

# ---------------------------------------------
# AI & Search Service Configuration
# ---------------------------------------------
# Python/FastAPI Environment
PYTHONUNBUFFERED=1

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=/app/chroma_db
CHROMA_COLLECTION_NAME=knowledgehub_documents

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Text Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# ---------------------------------------------
# Logging Configuration
# ---------------------------------------------
LOG_LEVEL=INFO
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_KNOWLEDGEHUB=DEBUG
LOG_LEVEL_SQL=DEBUG
LOG_LEVEL_MONGODB=INFO
LOG_LEVEL_GATEWAY=DEBUG
LOG_LEVEL_NETTY=DEBUG

# ---------------------------------------------
# CORS Configuration
# ---------------------------------------------
# Browser Origin header is based on where the page was loaded from:
# - http://localhost:4200 = Local development (ng serve)
# - http://localhost:80 = Docker production (browser loads from localhost:80)
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost
CORS_ALLOWED_ORIGINS=http://192.168.56.11:80,http://192.168.56.11:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# ---------------------------------------------
# API Documentation (Swagger)
# ---------------------------------------------
SWAGGER_ENABLED=true

# ---------------------------------------------
# Health Check / Actuator Configuration
# ---------------------------------------------
# Use fully-qualified keys to avoid overriding `management.endpoints` as a raw string.
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# ---------------------------------------------
# Docker Network
# ---------------------------------------------
DOCKER_NETWORK=knowledgehub-network

# ---------------------------------------------
# Volume Paths (for local development)
# ---------------------------------------------
MYSQL_DATA_PATH=./volumes/mysql
MONGO_DATA_PATH=./volumes/mongodb
MINIO_DATA_PATH=./volumes/minio
CHROMA_DATA_PATH=./volumes/chromadb

# ---------------------------------------------
# Service URLs (for inter-service communication)
# ---------------------------------------------
# For Docker: use service names (containers on same network)
# For local dev: use 'localhost'
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
RESOURCE_SERVICE_URL=http://resource-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084
AI_SEARCH_SERVICE_URL=http://ai-search-service:8000

# ---------------------------------------------
# Frontend Configuration (if applicable)
# ---------------------------------------------
FRONTEND_URL=http://192.168.56.11:80

# ---------------------------------------------
# Development/Production Toggle
# ---------------------------------------------
ENVIRONMENT=development
# Options: development, staging, production

# ---------------------------------------------
# Feature Flags
# ---------------------------------------------
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_AI_SEARCH=true
FEATURE_FILE_SCANNING=true

# ---------------------------------------------
# Rate Limiting (if implemented)
# ---------------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ---------------------------------------------
# Session Configuration
# ---------------------------------------------
SESSION_TIMEOUT=3600
# Session timeout in seconds (3600 = 1 hour)
